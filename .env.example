# Скопируйте в .env и заполните. В git .env не попадает.
# База из compose; вне Docker замените db на localhost.
DATABASE_URL=postgresql+psycopg://club:club@db:5432/club
BOT_TOKEN=
# В compose: socks5://tgproxy:1080 (AiohttpSession не поддерживает socks5h)
TELEGRAM_PROXY=
OWNER_TG_ID=
CHANNEL_ID=
CHAT_ID=
CHANNEL_INVITE_LINK=
# Домен сайта для ops/club.caddy (Caddy читает {$DOMAIN})
DOMAIN=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=
PUBLIC_BASE_URL=
HEARTBEAT_URL=
HEARTBEAT_TOKEN=
# Через сколько секунд без отметки сервис считается мёртвым.
HEALTH_STALE_SECONDS=180
# Ключ для подробного /healthz: Authorization: Bearer <токен>.
# Пусто — подробный отчёт не отдаётся никому. Пример: openssl rand -hex 32
HEALTHZ_TOKEN=
TZ=Europe/Moscow
# Окно оплаты: первый день — он же якорь окончания периода.
PAYMENT_WINDOW_START_DAY=22
PAYMENT_WINDOW_END_DAY=24
# Необязательные пороги подробного /healthz; 0 — выключено.
# HEALTH_MAX_BILLING_AGE_SEC=0
# HEALTH_MAX_BOT_AGE_SEC=0

# Параметры контейнера PostgreSQL из docker-compose.yml
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=club

# Миграция из Salebot (Task 15); ключ только в .env
SALEBOT_API_KEY=
SALEBOT_API_BASE=https://chatter.salebot.pro/api

# Деплой/хартбит
AMNEZIA_SSH_HOST=
AMNEZIA_SSH_USER=
AMNEZIA_SSH_PORT=22
TGPROXY_KEY_PATH=./secrets/tgproxy
SUMMARY_BULK_THRESHOLD=10

CONTENT_DIR=./content
CONTENT_DIR_HOST=./content
