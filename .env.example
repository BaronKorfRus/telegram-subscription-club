# Скопируйте в .env и заполните. В git .env не попадает.
# База из compose; вне Docker замените db на localhost.
DATABASE_URL=postgresql+psycopg://club:club@db:5432/club
BOT_TOKEN=
# В compose: socks5://tgproxy:1080 (AiohttpSession не поддерживает socks5h)
TELEGRAM_PROXY=
OWNER_TG_ID=
CHANNEL_ID=
CHAT_ID=
CHANNEL_INVITE_LINK=
# Домен сайта для ops/club.caddy (Caddy читает {$DOMAIN})
DOMAIN=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=
PUBLIC_BASE_URL=
HEARTBEAT_URL=
HEARTBEAT_TOKEN=
TZ=Europe/Moscow

# Параметры контейнера PostgreSQL из docker-compose.yml
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=club

# Миграция из Salebot (Task 15); ключ только в .env
SALEBOT_API_KEY=
SALEBOT_API_BASE=https://chatter.salebot.pro/api

# Деплой/бэкап/хартбит
BACKUP_DIR=./backups
BACKUP_REMOTE=
AMNEZIA_SSH_HOST=
AMNEZIA_SSH_USER=
AMNEZIA_SSH_PORT=22
TGPROXY_KEY_PATH=./secrets/tgproxy
SUMMARY_BULK_THRESHOLD=10

CONTENT_DIR=./content/example
